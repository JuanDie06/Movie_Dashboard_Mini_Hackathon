{
  "info": {
    "name": "Movie Dashboard API",
    "description": "Complete REST API for Movie Dashboard - Rails Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Movies",
      "item": [
        {
          "name": "List All Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/movies?page=1&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["movies"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "per_page",
                  "value": "20",
                  "description": "Items per page"
                }
              ]
            },
            "description": "Get all movies with pagination"
          }
        },
        {
          "name": "Search Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/movies?search=Mission",
              "host": ["{{base_url}}"],
              "path": ["movies"],
              "query": [
                {
                  "key": "search",
                  "value": "Mission",
                  "description": "Search by movie title"
                }
              ]
            },
            "description": "Search movies by title (case-insensitive)"
          }
        },
        {
          "name": "Filter Movies by Genre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/movies?genre_id=39",
              "host": ["{{base_url}}"],
              "path": ["movies"],
              "query": [
                {
                  "key": "genre_id",
                  "value": "39",
                  "description": "Filter by genre ID (39 = Action)"
                }
              ]
            },
            "description": "Get movies by genre"
          }
        },
        {
          "name": "Get Single Movie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/movies/42",
              "host": ["{{base_url}}"],
              "path": ["movies", "42"]
            },
            "description": "Get movie details with genres, reviews, and watchlists"
          }
        },
        {
          "name": "Get Popular Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/movies/popular?page=1",
              "host": ["{{base_url}}"],
              "path": ["movies", "popular"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Get popular movies sorted by rating"
          }
        },
        {
          "name": "Get Recent Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/movies/recent",
              "host": ["{{base_url}}"],
              "path": ["movies", "recent"]
            },
            "description": "Get recently added movies"
          }
        },
        {
          "name": "Create Movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movie\": {\n    \"tmdb_id\": 12345,\n    \"title\": \"Test Movie\",\n    \"overview\": \"This is a test movie\",\n    \"release_date\": \"2025-12-31\",\n    \"poster_path\": \"/test.jpg\",\n    \"backdrop_path\": \"/test_backdrop.jpg\",\n    \"vote_average\": 8.5,\n    \"vote_count\": 100,\n    \"runtime\": 120,\n    \"status\": \"Released\"\n  },\n  \"genre_ids\": [39, 40]\n}"
            },
            "url": {
              "raw": "{{base_url}}/movies",
              "host": ["{{base_url}}"],
              "path": ["movies"]
            },
            "description": "Create a new movie"
          }
        },
        {
          "name": "Update Movie",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movie\": {\n    \"title\": \"Updated Movie Title\",\n    \"overview\": \"Updated overview\",\n    \"vote_average\": 9.0\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/movies/42",
              "host": ["{{base_url}}"],
              "path": ["movies", "42"]
            },
            "description": "Update movie details"
          }
        },
        {
          "name": "Delete Movie",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/movies/42",
              "host": ["{{base_url}}"],
              "path": ["movies", "42"]
            },
            "description": "Delete a movie (use with caution)"
          }
        },
        {
          "name": "Sync Movie from TMDB",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tmdb_id\": 550\n}"
            },
            "url": {
              "raw": "{{base_url}}/movies/sync_from_tmdb",
              "host": ["{{base_url}}"],
              "path": ["movies", "sync_from_tmdb"]
            },
            "description": "Sync a movie from TMDB API by TMDB ID (e.g., 550 = Fight Club)"
          }
        }
      ]
    },
